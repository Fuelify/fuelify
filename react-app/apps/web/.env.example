# Supabase — single backend for auth + all data
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Set to "true" to skip login (uses Supabase anonymous sign-in)
NEXT_PUBLIC_AUTH_DISABLED=false

# Grocery store connections (Premium) — see DEPLOYMENT.md. Server-only, never NEXT_PUBLIC_.
# KROGER_CLIENT_ID=
# KROGER_CLIENT_SECRET=
# WALMART_CONSUMER_ID=
# WALMART_PRIVATE_KEY=
# WALMART_KEY_VERSION=1
# WALMART_PUBLISHER_ID=
# INSTACART_API_KEY=
# INSTACART_API_BASE=https://connect.instacart.com
